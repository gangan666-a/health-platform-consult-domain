{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "analyzer": {
        "ik": { "type": "custom", "tokenizer": "ik_max_word" }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "doc_id": { "type": "keyword" },
      "disease_id": { "type": "keyword" },
      "name": {
        "type": "text",
        "analyzer": "ik_max_word",
        "search_analyzer": "ik_smart",
        "fields": { "keyword": { "type": "keyword" } }
      },
      "alias": { "type": "keyword" },
      "icd10": { "type": "keyword" },
      "category": { "type": "keyword" },
      "department_ids": { "type": "keyword" },
      "symptom_ids": { "type": "keyword" },
      "cause": { "type": "text", "analyzer": "ik_max_word", "search_analyzer": "ik_smart" },
      "diagnosis": { "type": "text", "analyzer": "ik_max_word", "search_analyzer": "ik_smart" },
      "treatment": { "type": "text", "analyzer": "ik_max_word", "search_analyzer": "ik_smart" },
      "prognosis": { "type": "text", "analyzer": "ik_max_word", "search_analyzer": "ik_smart" },
      "emergency": { "type": "boolean" },
      "agent_type": { "type": "keyword" },
      "status": { "type": "keyword" },
      "updated_at": { "type": "date" },
      "embedding": {
        "type": "dense_vector",
        "dims": 1024,
        "similarity": "cosine",
        "index": true,
        "index_options": { "type": "hnsw", "m": 16, "ef_construction": 100 }
      }
    }
  }
}
