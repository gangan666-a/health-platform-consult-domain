{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "analyzer": {
        "ik": { "type": "custom", "tokenizer": "ik_max_word" }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "doc_id": { "type": "keyword" },
      "drug_id": { "type": "keyword" },
      "name": {
        "type": "text",
        "analyzer": "ik_max_word",
        "search_analyzer": "ik_smart",
        "fields": { "keyword": { "type": "keyword" } }
      },
      "generic_name": {
        "type": "text",
        "analyzer": "ik_max_word",
        "search_analyzer": "ik_smart",
        "fields": { "keyword": { "type": "keyword" } }
      },
      "brand_name": { "type": "keyword" },
      "pinyin": { "type": "keyword" },
      "spec": { "type": "keyword" },
      "dosage_form": { "type": "keyword" },
      "drug_class": { "type": "keyword" },
      "category": { "type": "keyword" },
      "rx_flag": { "type": "boolean" },
      "population": { "type": "keyword" },
      "indication": { "type": "text", "analyzer": "ik_max_word", "search_analyzer": "ik_smart" },
      "contraindication": { "type": "text", "analyzer": "ik_max_word", "search_analyzer": "ik_smart" },
      "side_effect": { "type": "text", "analyzer": "ik_max_word", "search_analyzer": "ik_smart" },
      "usage_dosage": { "type": "text", "analyzer": "ik_max_word", "search_analyzer": "ik_smart" },
      "ingredients": { "type": "keyword" },
      "interaction_ids": { "type": "keyword" },
      "price": { "type": "scaled_float", "scaling_factor": 100 },
      "agent_type": { "type": "keyword" },
      "status": { "type": "keyword" },
      "updated_at": { "type": "date" },
      "embedding": {
        "type": "dense_vector",
        "dims": 1024,
        "similarity": "cosine",
        "index": true,
        "index_options": { "type": "hnsw", "m": 16, "ef_construction": 100 }
      }
    }
  }
}
