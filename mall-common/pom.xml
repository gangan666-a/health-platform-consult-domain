<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example</groupId>
        <artifactId>simple-mall-ai-shopping-guide</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>mall-common</artifactId>
    <name>mall-common</name>
    <description>共享库：业务异常、订单状态枚举、服务间 DTO</description>

    <!-- 纯 jar 库，不打包可执行 fat jar，也不声明 spring-boot-maven-plugin -->
    <dependencies>
        <!-- DTO 上的 @JsonIgnoreProperties 注解（版本由 spring-boot-starter-parent 管理） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <!-- RecommendRequest 等 DTO 的 Bean Validation 注解（如 @NotNull），版本由 spring-boot-starter-parent 管理 -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
    </dependencies>
</project>
