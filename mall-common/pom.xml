<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example</groupId>
        <artifactId>simple-mall-ai-shopping-guide</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>mall-common</artifactId>
    <name>mall-common</name>
    <description>共享库：业务异常、订单状态枚举、服务间 DTO</description>

    <!-- 纯 jar 库，不打包可执行 fat jar，也不声明 spring-boot-maven-plugin -->
    <dependencies>
        <!-- DTO 上的 @JsonIgnoreProperties 注解（版本由 spring-boot-starter-parent 管理） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <!-- RecommendRequest 等 DTO 的 Bean Validation 注解（如 @NotNull），版本由 spring-boot-starter-parent 管理 -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>

        <!-- 动态埋点（链路追踪）：AOP 支持（TraceAspect 的 @Around）。compile 传递到全部服务（各服务 compile 依赖 mall-common） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <!-- spring-web：OncePerRequestFilter / ClientHttpRequestInterceptor 等接口（版本由 spring-boot-starter-parent 管理） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!-- jakarta.servlet：TraceFilter 的 Servlet API（spring-web 中为 provided 不会传递，需显式声明，版本由 parent 管理） -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
        </dependency>

        <!-- 测试：JUnit 5 + spring-test（MockHttpServletRequest / MockClientHttpRequest），版本由 parent 管理 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
